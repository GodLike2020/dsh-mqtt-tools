{
  "name": "dsh-mqtt-tools",
  "version": "0.3.11",
  "description": "MQTT client and embedded broker for DeepSeek Harness: named connections, subscribe and publish, a live message log, a local MQTT server (3.1 / 3.1.1 / 5.0) and nine mqtt_* agent tools — from one panel.",
  "icon": "icon.svg",
  "type": "module",
  "license": "MIT",
  "author": "dsh-mqtt-tools contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GodLike2020/dsh-mqtt-tools.git"
  },
  "homepage": "https://github.com/GodLike2020/dsh-mqtt-tools#readme",
  "bugs": {
    "url": "https://github.com/GodLike2020/dsh-mqtt-tools/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mqtt",
    "mqtt-client",
    "mqtt-broker",
    "mqtt5",
    "iot",
    "aedes",
    "agent-tools"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/*.png"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node scripts/suite/run-all.mjs",
    "test:offline": "node scripts/suite/run-all.mjs protocol lifecycle perf ui"
  },
  "dependencies": {
    "aedes": "^1.2.0",
    "mqtt": "^5.16.1",
    "mqtt-packet": "^9.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "puppeteer-core": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
